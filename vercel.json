{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://cskelectronicservices.up.railway.app/api/:path*"
    }
  ],
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}